# ============================================================
# DeltaRL Trader — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- OPERATING MODE ----------------------------------------
# "demo" or "live" — controls which API keys & endpoints are used
# Always start with "demo" for safe RL training
TRADING_MODE=demo

# ---- DEMO / TESTNET API (India) ----------------------------
# Get keys from: https://testnet.delta.exchange → Profile → API Keys
DEMO_API_KEY=your_demo_api_key_here
DEMO_API_SECRET=your_demo_api_secret_here

# ---- LIVE / PRODUCTION API (India) -------------------------
# Get keys from: https://app.india.delta.exchange → Profile → API Keys
# WARNING: These keys can place REAL orders with REAL money
LIVE_API_KEY=your_live_api_key_here
LIVE_API_SECRET=your_live_api_secret_here

# ---- EXCHANGE ENDPOINTS ------------------------------------
# India Demo (Testnet)
DEMO_REST_URL=https://cdn-ind.testnet.deltaex.org
DEMO_WS_URL=wss://socket.ind.testnet.deltaex.org/live

# India Production
LIVE_REST_URL=https://api.india.delta.exchange
LIVE_WS_URL=wss://socket.india.delta.exchange/live

# ---- TRADING CONFIG ----------------------------------------
# Comma-separated perpetual futures symbols to trade
TRADING_PAIRS=BTCUSDT,ETHUSDT

# Default timeframe in minutes
TIMEFRAME_MINUTES=5

# Maximum leverage allowed (Delta Exchange supports 1-20x for major pairs)
MAX_LEVERAGE=20

# Max risk per trade as percentage of equity (0.01 = 1%)
MAX_RISK_PER_TRADE=0.01

# Maximum portfolio drawdown before circuit breaker pauses trading (0.05 = 5%)
CIRCUIT_BREAKER_DRAWDOWN=0.05

# ---- RL CONFIGURATION --------------------------------------
# Path where trained model checkpoints are saved
MODEL_DIR=./models

# PPO learning rate
RL_LEARNING_RATE=0.0003

# Steps before each PPO update
RL_N_STEPS=2048

# Mini-batch size for PPO gradient updates
RL_BATCH_SIZE=64

# Number of PPO epochs per update
RL_N_EPOCHS=10

# Discount factor (gamma)
RL_GAMMA=0.99

# GAE lambda
RL_GAE_LAMBDA=0.95

# Online fine-tuning: update model every N closed trades
FINE_TUNE_EVERY_N_TRADES=5

# ---- DATABASE ----------------------------------------------
# SQLite (default — zero config for local dev)
DATABASE_URL=sqlite:///./data/deltarl.db

# Uncomment and set for PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@db:5432/deltarl

# ---- REDIS -------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Max episodes to store in replay buffer
REPLAY_BUFFER_SIZE=10000

# ---- FASTAPI SERVER ----------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for signing internal tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_to_a_random_secure_string_please

# ---- ALERTS (optional) ------------------------------------
# Leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- SIMULATION MODE ---------------------------------------
# If true: agent makes predictions but NO actual orders are placed
# P&L is simulated from real price movement. Safest for initial training.
SIMULATION_ONLY=true

# ---- LOGGING -----------------------------------------------
LOG_LEVEL=INFO
